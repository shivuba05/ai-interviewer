# ============================================================
# AI Interviewer – Environment Variables
# ============================================================

# Server Port
PORT=5000

# Google Gemini API Key (Required for AI dynamic questioning, follow-ups, and evaluation)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Supabase Configuration (Optional for persistence, demo mode will activate if blank)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

